# Configuração pública do Firebase Auth (Firebase Console > Configurações do projeto > Seus apps).
# Dev: copie este arquivo para `.env` e preencha com os valores do projeto dev.
# Prod: crie um `.env.production` (não versionado) com os valores do projeto prod;
# o `vite build` (modo production) dá precedência a ele sobre o `.env`.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
